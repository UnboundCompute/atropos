    "Raise", "Assert", "Import", "ImportFrom", "Global", "Nonlocal",
    "Pass", "Break", "Continue", "Expr",
    "Call", "Name", "Attribute", "Subscript", "Constant", "keyword", "comprehension",
    "BinOp", "UnaryOp", "BoolOp", "Compare", "Slice", "Index",
    "Tuple", "List", "Dict", "Set", "Load", "Store", "Del",
    "Add", "Sub", "Mult", "Div", "Mod", "Pow", "LShift", "RShift",
    "BitOr", "BitAnd", "BitXor", "FloorDiv", "MatMult",
    "And", "Or", "Not", "Invert", "UAdd", "USub",
    "Eq", "NotEq", "Lt", "LtE", "Gt", "GtE", "Is", "IsNot", "In", "NotIn"
  ],
  "lowered": {
